# ==============================================================================
# EMPLOYEE MANAGEMENT SYSTEM (EMS) - BACKEND CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Client Application URL (for CORS allowed origins)
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:8080

# Supabase API Credentials
# Retrieve these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Organization Default Timezone (IANA Timezone String)
ORG_TIMEZONE=UTC
